#include <windows.h>
#pragma code_page(65001)

/* 文件图标：资源 id 1，Explorer/任务栏/属性页都读它 */
1 ICON "pet.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 21,0,0,0
 PRODUCTVERSION 21,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "FileDescription", "桌宠「白」\0"
            VALUE "FileVersion", "21.0\0"
            VALUE "InternalName", "pet\0"
            VALUE "LegalCopyright", "空与白\0"
            VALUE "OriginalFilename", "pet.exe\0"
            VALUE "ProductName", "桌宠白\0"
            VALUE "ProductVersion", "v21\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
